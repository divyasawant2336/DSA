#include <stdio.h>
#include <string.h>

struct Student {
    int roll;
    char name[50];
    int age;
    float marks;
};
void create(struct Student s[], int *n);
void display(struct Student s[], int n);
void modify(struct Student s[], int n);
void search(struct Student s[], int n);
void sort(struct Student s[], int n);

int main(){
    struct Student s[100];
    int n = 0;
    int choice;
    do{
        printf("DATABASE MANAGEMENT SYSTEM\n");
        printf("1. Create Records\n");
        printf("2. Display Records\n");
        printf("3. Modify Record\n");
        printf("4. Search Record\n");
        printf("5. Sort Records\n");
        printf("6. Exit\n");
        printf("Enter your choice: ");
        scanf("%d", &choice);
        switch(choice){
            case 1:
                create(s,&n);
                break;
            case 2:
                display(s,n);
                break;
            case 3:
                modify(s,n);
                break;
            case 4:
                search(s,n);
                break;
            case 5:
                sort(s,n);
                break;
            case 6:
                printf("Exiting program...\n");
                break;
            default:
                printf("Invalid choice!\n");
        }
    } while(choice != 6);
    return 0;
}
void create(struct Student s[],int *n){
    int i,num;
    printf("How many students do you want to add? ");
    scanf("%d",&num);
    for(i=0;i<num;i++) {
        printf("\nEnter details of Student %d\n", *n+1);
        printf("Enter Roll Number: ");
        scanf("%d", &s[*n].roll);
        printf("Enter Name: ");
        scanf(" %[^\n]", s[*n].name);
        printf("Enter Age: ");
        scanf("%d", &s[*n].age);
        printf("Enter Marks: ");
        scanf("%f", &s[*n].marks);
        (*n)++;
    }
    printf("\nRecords created successfully!\n");
}
void display(struct Student s[],int n){
    int i;
    if(n == 0){
        printf("\nNo records available!\n");
        return;
    }
    printf("STUDENT RECORDS\n");
    for(i = 0; i < n; i++){
        printf("\nStudent %d\n", i+1);
        printf("Roll Number: %d\n", s[i].roll);
        printf("Name: %s\n", s[i].name);
        printf("Age: %d\n", s[i].age);
        printf("Marks: %.2f\n", s[i].marks);
    }
}
void modify(struct Student s[], int n){
    int roll,i,found=0;
    if(n==0){
        printf("\nNo records available!\n");
        return;
    }
    printf("Enter Roll Number of student to modify: ");
    scanf("%d", &roll);
    for(i = 0; i < n; i++){
        if(s[i].roll == roll) {
            found = 1;
            printf("\nEnter new Name: ");
            scanf(" %[^\n]", s[i].name);
            printf("Enter new Age: ");
            scanf("%d", &s[i].age);
            printf("Enter new Marks: ");
            scanf("%f", &s[i].marks);
            printf("\nRecord modified successfully!\n");
            break;
        }
    }
    if(found == 0) {
        printf("\nStudent not found!\n");
    }
}
void search(struct Student s[], int n){
    int roll, i,found=0;
    if(n==0){
        printf("\nNo records available!\n");
        return;
    }
    printf("Enter Roll Number to search: ");
    scanf("%d", &roll);
    for(i = 0; i < n; i++){
        if(s[i].roll == roll){
            found = 1;
            printf("\nStudent Found!\n");
            printf("Roll Number: %d\n", s[i].roll);
            printf("Name: %s\n", s[i].name);
            printf("Age: %d\n", s[i].age);
            printf("Marks: %.2f\n", s[i].marks);
            break;
        }
    }
    if(found == 0){
        printf("\nStudent not found!\n");
    }
}
void sort(struct Student s[], int n){
    int i, j;
    struct Student temp;
    if(n == 0){
        printf("\nNo records available!\n");
        return;
    }
    for(i = 0; i < n - 1; i++){
        for(j = 0; j < n - i - 1; j++){
            if(s[j].roll > s[j + 1].roll)
            {
                temp = s[j];
                s[j] = s[j + 1];
                s[j + 1] = temp;
            }
        }
    }
    printf("\nRecords sorted successfully by Roll Number!\n");
}
