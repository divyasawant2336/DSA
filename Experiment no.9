#include <stdio.h>

#define MAX 20
#define INF 9999

int main() {
    int cost[MAX][MAX];
    int visited[MAX] = {0};
    int n, i, j;
    int edges = 0, min, a = 0, b = 0;
    int minCost = 0;

    printf("Enter number of vertices: ");
    scanf("%d", &n);

    printf("Enter adjacency matrix:\n");

    for (i = 0; i < n; i++) {
        for (j = 0; j < n; j++) {
            scanf("%d", &cost[i][j]);

            if (cost[i][j] == 0)
                cost[i][j] = INF;
        }
    }

     visited[0] = 1;

    printf("\nEdges in Minimum Spanning Tree:\n");

    while (edges < n - 1) {
        min = INF;

        for (i = 0; i < n; i++) {
            if (visited[i]) {
                for (j = 0; j < n; j++) {
                    if (!visited[j] && cost[i][j] < min) {
                        min = cost[i][j];
                        a = i;
                        b = j;
                    }
                }
            }
        }

        if (min == INF) {
            printf("\nGraph is disconnected!");
            return 0;
        }

        printf("%d - %d : %d\n", a + 1, b + 1, min);

        minCost += min;
        visited[b] = 1;
        edges++;
    }

    printf("\nMinimum Cost = %d\n", minCost);
    return 0;
}
